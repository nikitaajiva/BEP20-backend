/**
 * Check missing deposits in xrpdeposits
 *
 * Usage:
 *   node scripts/checkMissingDeposits.js               # defaults to today (UTC)
 *   node scripts/checkMissingDeposits.js 2025-09-15    # pass specific date (YYYY-MM-DD)
 */

const mongoose = require("mongoose");
const fs = require("fs");
const path = require("path");
const connectDB = require("../config/db");
const cDeposit = require("../models/ChainDeposit"); // adjust path
const XrpDeposit = require("../models/XrpDeposit"); // adjust path

/* --------------------------- LOGGING --------------------------- */
const LOGS_DIR = "/root/b/logs";
if (!fs.existsSync(LOGS_DIR)) fs.mkdirSync(LOGS_DIR, { recursive: true });

function getLogFileName() {
  const d = new Date();
  const y = d.getUTCFullYear();
  const m = String(d.getUTCMonth() + 1).padStart(2, "0");
  const day = String(d.getUTCDate()).padStart(2, "0");
  return path.join(LOGS_DIR, `missing_deposits_${y}-${m}-${day}.log`);
}
const logFile = getLogFileName();

function log(msg) {
  const line = `[${new Date().toISOString()}] ${msg}`;
  console.log(line);
  fs.appendFileSync(logFile, line + "\n");
}

/* --------------------------- MAIN --------------------------- */
async function run() {
  await connectDB();

  // --- Pick date ---
  const argDate = process.argv[2];
  const targetDate = argDate ? new Date(argDate) : new Date();
  const startOfDay = new Date(Date.UTC(
    targetDate.getUTCFullYear(),
    targetDate.getUTCMonth(),
    targetDate.getUTCDate(),
    0, 0, 0
  ));
  const endOfDay = new Date(Date.UTC(
    targetDate.getUTCFullYear(),
    targetDate.getUTCMonth(),
    targetDate.getUTCDate(),
    23, 59, 59
  ));

  log(`🔎 Checking cDeposits from ${startOfDay.toISOString()} → ${endOfDay.toISOString()}`);

  // --- Find deposits ---
  const deposits = await cDeposit.find({
    txDate: { $gte: startOfDay, $lte: endOfDay }
  });

  log(`📥 Found ${deposits.length} cDeposits`);
  let created = 0;
  const now = new Date();

  for (const d of deposits) {
    const ageMinutes = (now - d.txDate) / (1000 * 60);

    if (ageMinutes < 6) {
      log(`⏳ Skipping tx ${d.txHash} (only ${ageMinutes.toFixed(1)} min old)`);
      continue;
    }

    const exists = await XrpDeposit.findOne({ transactionId: d.txHash });
    if (!exists) {
      await XrpDeposit.create({
        user: d.userId,
        walletAddress: d.source,   // ✅ use source
        transactionId: d.txHash,
        amount: d.raw?.tx?.Amount?.toString() || "0",  // ✅ use raw.tx.Amount (drops)
        ledgerTimestamp: d.txDate,
        status: "failed",
        createdAt: new Date(),
        processingError: null
      });
      created++;
      log(`⚠️ Missing deposit → Inserted failed xrpdeposit for tx ${d.txHash} amount=${d.raw?.tx?.Amount}`);
    }
  }

  log(`✅ Completed. Inserted ${created} new failed xrpdeposits`);
  process.exit(0);
}

run().catch((err) => {
  log("❌ Error: " + err.message);
  process.exit(1);
});
